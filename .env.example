# ── Database ──
APP_DATABASE_URL=

# ── Valkey (Redis-compatible message broker) ──
APP_REDIS_URL=redis://valkey:6379/0

# ── MinIO (S3-compatible) ──
APP_MINIO_ENDPOINT=minio:9000
APP_MINIO_PUBLIC_ENDPOINT=localhost:8080
APP_MINIO_PUBLIC_PATH_PREFIX=/minio
APP_MINIO_ACCESS_KEY=
APP_MINIO_SECRET_KEY=
APP_MINIO_BUCKET=campaign-assets
APP_MINIO_USE_SSL=false

# ── Provider mode (local-only) ──
APP_PROVIDER_MODE=local

# ── LLM (local Ollama or via OpenClaw gateway) ──
# Set to "openclaw" to route LLM calls through the OpenClaw gateway,
# or "local" to call Ollama directly.
APP_LLM_PROVIDER_MODE=openclaw
APP_LLM_BASE_URL=
APP_LLM_API_KEY=
APP_LLM_MODEL=qwen3:8b

# ── OpenClaw gateway (used when APP_LLM_PROVIDER_MODE=openclaw) ──
APP_OPENCLAW_GATEWAY_URL=http://openclaw:18789/v1
APP_OPENCLAW_API_KEY=adgen-openclaw-internal
APP_OPENCLAW_AGENT_ID=main

# ── Image provider ──
APP_IMAGE_API_URL=
APP_IMAGE_API_KEY=
APP_NEWSAPI_KEY=<ADD NEWSAPI KEY HERE>
# Market enrichment: NewsAPI + community signals (Reddit search RSS + HN for tech verticals)
APP_MARKET_DATA_COUNTRY=us
APP_MARKET_DATA_TREND_TIMEFRAME=today 3-m

# ── TTS ──
APP_TTS_API_URL=http://kokoro-tts:8880

# ── Video (local LTX-Video) ──
APP_VIDEO_PROVIDER_MODE=local
APP_VIDEO_API_URL=http://ltx-video:8004

# ── Local provider URLs (used when provider_mode=local) ──
APP_LOCAL_LLM_URL=http://ollama:11434/v1
APP_LOCAL_IMAGE_URL=http://flux-server:8002
APP_LOCAL_TTS_URL=http://kokoro-tts:8880
APP_LOCAL_VIDEO_URL=http://ltx-video:8004

# ── CORS ──
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Debug ──
APP_DEBUG=false

# ── Host home dir (sudo sets HOME=/root, breaking volume mounts) ──
HOST_HOME=/home/<your-username>

# ── HuggingFace Token (required for gated models like FLUX.1-Dev) ──
HF_TOKEN=<ADD TOKEN HERE>

# ── GPU Assignment ──
# GPU IDs for HIP_VISIBLE_DEVICES in each service container.
# 4-GPU default: Ollama=0, FLUX-1=1, FLUX-2=2, LTX-Video=3
# 2-GPU setup:   Ollama=0, and set FLUX_GPU_ID=1 or LTX_VIDEO_GPU_ID=1
OLLAMA_GPU_ID=0
FLUX_GPU_ID=1
FLUX_GPU_2_ID=2
LTX_VIDEO_GPU_ID=3

# ── Deployment Profiles ──
# Controls which GPU generation services start.
#   "image,image2,video" = 4-GPU setup (parallel image gen + video)
#   "image,video"        = 3-GPU or partial setup (single image + video)
#   "image"              = 2-GPU setup with image generation only
#   "video"              = 2-GPU setup with video generation only
COMPOSE_PROFILES=image,image2,video

# ── Frontend / Browser-side routing (nginx subpaths) ──
VITE_API_TARGET=http://backend:8000
VITE_PROM_TARGET=http://prometheus:9090
VITE_API_URL=/backend
VITE_PROM_BASE=/metrics
