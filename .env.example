# Environment Variables -- AI Ad Campaign Pipeline
#
# Copy this file to .env and fill in values for your deployment.
# All variables use the APP_ prefix and are loaded by pydantic-settings.
# Development defaults are provided where safe; production deployments MUST
# override all credentials.

# ============================================================================
# DATABASE
# ============================================================================
APP_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/adgen

# ============================================================================
# REDIS / VALKEY (Celery broker + result backend)
# ============================================================================
APP_REDIS_URL=redis://valkey:6379/0

# ============================================================================
# RUSTFS (S3-compatible object storage -- Apache-2.0 licensed)
# ============================================================================
APP_MINIO_ENDPOINT=rustfs:9000
APP_MINIO_ACCESS_KEY=CHANGE_ME
APP_MINIO_SECRET_KEY=CHANGE_ME
APP_MINIO_BUCKET=campaign-assets
APP_MINIO_USE_SSL=false
APP_MINIO_PUBLIC_ENDPOINT=
APP_MINIO_PUBLIC_PATH_PREFIX=
APP_MINIO_REGION=us-east-1

# ============================================================================
# PROVIDER MODE
# ============================================================================
# "local" uses Docker Compose services (Ollama, FLUX, etc.)
# "cloud" would use external API endpoints
APP_PROVIDER_MODE=local

# Per-provider overrides (optional -- defaults to APP_PROVIDER_MODE)
# APP_LLM_PROVIDER_MODE=local
# APP_IMAGE_PROVIDER_MODE=local
# APP_TTS_PROVIDER_MODE=local
# APP_VIDEO_PROVIDER_MODE=local

# ============================================================================
# LLM PROVIDER
# ============================================================================
APP_LLM_BASE_URL=http://ollama:11434/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=qwen3:8b

# ============================================================================
# IMAGE PROVIDER
# ============================================================================
APP_IMAGE_API_URL=http://flux-server:8002
APP_IMAGE_API_KEY=
APP_IMAGE_MODEL_NAME=FLUX.1-schnell

# ============================================================================
# TTS PROVIDER
# ============================================================================
APP_TTS_API_URL=http://kokoro-tts:8880

# ============================================================================
# VIDEO PROVIDER
# ============================================================================
APP_VIDEO_API_URL=http://ltx-video:8004

# ============================================================================
# LOCAL PROVIDER URLS (used when provider_mode is "local")
# ============================================================================
APP_LOCAL_LLM_URL=http://ollama:11434/v1
APP_LOCAL_IMAGE_URL=http://flux-server:8002
APP_LOCAL_TTS_URL=http://kokoro-tts:8880
APP_LOCAL_VIDEO_URL=http://ltx-video:8004

# ============================================================================
# OPENCLAW GATEWAY (used when llm_provider_mode is "openclaw")
# ============================================================================
APP_OPENCLAW_GATEWAY_URL=http://openclaw:18789/v1
APP_OPENCLAW_API_KEY=CHANGE_ME
APP_OPENCLAW_AGENT_ID=main


# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of allowed origins
# APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================================================
# DEBUG
# ============================================================================
APP_DEBUG=false

# ============================================================================
# DOCKER COMPOSE -- Infrastructure credentials (not APP_ prefixed)
# Generated by setup.sh. Do not commit real values.
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adgen
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
OPENCLAW_AUTH_TOKEN=CHANGE_ME

# ============================================================================
# GPU DEVICE ACCESS (auto-detected by setup.sh)
# ============================================================================
# GID of the group that owns /dev/kfd on the host (typically the "render" or
# "video" group). GPU containers run as non-root and use this GID via
# group_add to access ROCm device nodes. Detected automatically by setup.sh;
# override here only if auto-detection fails.
# Find it manually with:  stat -c '%g' /dev/kfd
RENDER_GID=109
